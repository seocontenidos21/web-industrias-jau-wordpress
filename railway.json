{
	"$schema": "https://railway.com/railway.schema.json",
	"build": {
		"builder": "DOCKERFILE",
		"dockerfilePath": "Dockerfile",
		"watchPatterns": [
			"Dockerfile",
			"docker/**",
			"wp-content/themes/industrias-jau/**",
			"wp-content/plugins/jau-core/**",
			"herramientas/**",
			"insumos-optimizados/**"
		]
	},
	"deploy": {
		"numReplicas": 1,
		"restartPolicyType": "ON_FAILURE",
		"restartPolicyMaxRetries": 5
	}
}
